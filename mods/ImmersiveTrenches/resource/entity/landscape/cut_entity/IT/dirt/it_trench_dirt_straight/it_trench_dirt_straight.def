{
	(include "/properties/trench.inc")
	{extension "it_trench_dirt_straight.mdl"}
	{DynCmpPersistent}
	{props "sand" "it_trench_upgradeable"}
	("boneLand" args "trench")
	("volume" args "body1")
	("volume" args "body2")
	("volume" args "body3")
	("volume" args "body4")
	("volume" args "body5")
	("volume" args "body6")
	("volume" args "body7")
	("volume" args "body8")
	{volume "upgrade_left"
		{tags "it_trench_upgrade_target"}
		{able clear {touch 1}}
	}
	{volume "upgrade_right"
		{tags "it_trench_upgrade_target"}
		{able clear {touch 1}}
	}
}
